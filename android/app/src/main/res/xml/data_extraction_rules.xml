<?xml version="1.0" encoding="utf-8"?>
<!-- Signing identities and their Keystore-protected credentials must never leave the device through
     cloud backup or device transfer; encrypted .hagbackup files are the supported recovery path. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
